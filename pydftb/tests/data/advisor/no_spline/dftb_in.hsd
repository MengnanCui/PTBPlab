Geometry = GenFormat {
    <<< "geo.gen"
}
Hamiltonian = DFTB {
   SCC = Yes
   SCCTolerance = 1e-6
   MaxAngularMomentum {
      Gd = "f"
      O = "p"
   }
   KPointsAndWeights = SupercellFolding {
      2 0 0
      0 2 0
      0 0 2
      0.5 0.5 0.5
   }
   SlaterKosterFiles = Type2FileNames {
      Prefix = ./
      Separator = "-"
      Suffix = ".skf"
   }
   Filling = Fermi { Temperature [K] = 1000 }
}

ParserOptions {
   ParserVersion = 14
}
