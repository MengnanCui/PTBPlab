Geometry = GenFormat {
    <<< "geo.gen"
}
Hamiltonian = DFTB {
   SCC = Yes
   SCCTolerance = 1e-6
   MaxAngularMomentum {
      Cu = "d"
   }
   KPointsAndWeights = SupercellFolding {
      2 0 0
      0 2 0
      0 0 2
      0.5 0.5 0.5
   }
   SlaterKosterFiles = Type2FileNames {
      Prefix = ./
      Separator = "-"
      Suffix = ".skf"
   }
   PolynomialRepulsive = SetForAll { Yes }
   Filling = Fermi { Temperature [K] = 300 }
   EwaldTolerance = 1e-12
}

ParserOptions {
   ParserVersion = 14
}
