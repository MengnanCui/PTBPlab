# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Run artefacts (DFTB+, hotcent, physrep outputs that land in cwd)
pot.out
charges.bin
band.out
detailed.out
detailed.xml
dftb_in.hsd
dftb_pin.hsd
dftb_band.xyz
dftb_full.xyz
dftb_sub_*.xyz
dft_final.xyz
dftb_dataset.xyz
geo_end.gen
geom.out.*
search_index.txt
SKF_*/
opt_*_*/
results/
*.traj
eos_*.json
result.pkl
# ... except the frozen DFTB+ runs of the advisor's tests (pydftb M3d)
!pydftb/tests/data/advisor/*/dftb_in.hsd
!pydftb/tests/data/advisor/*/dftb_pin.hsd
!pydftb/tests/data/advisor/*/geo_end.gen
# ... and the stored DFTB+ outputs of the DFTB+ engine's tests (pydftb P2)
!pydftb/tests/data/dftbplus_outputs/*/detailed.out

# OS
.DS_Store

# Example run artefacts (data is symlinked or generated by prepare.py)
examples/*/dft
examples/*/run/
examples/*/results/
examples/*/checkpoint.pkl
examples/*/result.pkl
examples/*/log.out
examples/*/par.out
examples/*/*.skf
examples/*/*.png
examples/*/console.out

# vendored hotcent built in place
third_party/hotcent/*.so
third_party/hotcent/build/
# per-run logs of the A-series scripts (utils/runlog.py) and their large files
examples/*/*/data/logs/
examples/08_accuracy/large/
